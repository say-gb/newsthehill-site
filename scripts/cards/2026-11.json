 "news-2026110900001": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>식품 안전</p>\n<h1>김장 재료 수입식품,<br>11월 9~20일 집중 검사</h1>\n<p class=\"dek\">통관단계 검사 강화와 유통 중인 김장 재료 수거·검사. 부적합은 반송·폐기·회수.<br>올해부터 김장매트 등 기구·용기도 검사 대상(빨간 표시).</p></div>\n<svg class=\"chart\" width=\"1200\" height=\"440\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 식품의약품안전처(2026.11.9 발표)</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst rows=[[\"농산물\",\"배추 · 고추 · 무 · 양파 · 생강 · 파 · 부추 등\",0],\n[\"수산물\",\"민물새우 · 염장새우 · 마른새우 · 마른명태 · 갈치 · 조기 등\",0],\n[\"가공식품\",\"절임배추 · 김칫속 · 액젓 · 고춧가루 · 천일염 · 설탕 · 물엿 등\",0],\n[\"기구·용기\",\"김장 매트·봉투 · 채칼 · 김치통 · 채반 · 고무장갑 등\",1]];\nconst s=document.getElementById('c'),rh=70,T0=100;let h='';\nrows.forEach(([n,t,nw],i)=>{const cy=T0+i*rh,col=nw?'#B5281F':'#2F5E35';\n h+=`<rect x=\"64\" y=\"${cy-26}\" width=\"8\" height=\"52\" fill=\"${col}\"/>`;\n h+=`<text x=\"92\" y=\"${cy+9}\" font-size=\"27\" font-weight=\"900\" fill=\"${col}\">${n}</text>`;\n if(nw)h+=`<rect x=\"232\" y=\"${cy-17}\" width=\"56\" height=\"30\" rx=\"4\" fill=\"#B5281F\"/><text x=\"260\" y=\"${cy+5}\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"900\" fill=\"#fff\">신규</text>`;\n h+=`<text x=\"310\" y=\"${cy+8}\" font-size=\"21\" fill=\"#1F211C\">${t}</text>`;\n h+=`<line x1=\"64\" y1=\"${cy+38}\" x2=\"1136\" y2=\"${cy+38}\" stroke=\"#1F211C\" stroke-opacity=\".12\"/>`;\n});\nh+=`<text x=\"64\" y=\"${T0+4*rh+20}\" font-size=\"18\" fill=\"#3d4437\">식품 검사 항목</text>`;\nh+=`<text x=\"210\" y=\"${T0+4*rh+22}\" font-size=\"21\" font-weight=\"700\" fill=\"#1F211C\">잔류농약 <tspan fill=\"#B5281F\" font-weight=\"900\" font-size=\"26\">514종</tspan> · 중금속(납·카드뮴) · 총아플라톡신 · 동물용의약품 · 보존료 · 타르색소 · 대장균 등</text>`;\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026110900002": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>식품·유통</p>\n<h1>나흘 새 가금농장 3곳…<br>여주 산란계도 고병원성 AI</h1>\n<p class=\"dek\">이번 동절기 가금농장 발생(빨간 점)과 강화된 방역 조치 기간.<br>점선은 확진일(11월 7일).</p></div>\n<svg class=\"chart\" width=\"1200\" height=\"440\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 농림축산식품부 고병원성 조류인플루엔자 중앙사고수습본부(2026.11.7 발표)</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst D=t=>new Date(t+'T00:00').getTime(),A=D('2026-11-02'),B=D('2026-11-19'),X0=470,X1=1040,x=t=>X0+(D(t)-A)/(B-A)*(X1-X0);\nconst s=document.getElementById('c'),rh=62,T0=86;let h='';\nfor(let d=3;d<=18;d++){const t=`2026-11-${String(d).padStart(2,'0')}`;if([3,5,7,9,11,13,15,17].includes(d))h+=`<text x=\"${x(t)}\" y=\"${T0-52}\" text-anchor=\"middle\" font-size=\"14\" fill=\"#5d6656\">${d}일</text>`;h+=`<line x1=\"${x(t)}\" y1=\"${T0-44}\" x2=\"${x(t)}\" y2=\"${T0+4*rh-10}\" stroke=\"#1F211C\" stroke-opacity=\".06\"/>`;}\nh+=`<line x1=\"${x('2026-11-07')}\" y1=\"${T0-40}\" x2=\"${x('2026-11-07')}\" y2=\"${T0+4*rh-10}\" stroke=\"#1F211C\" stroke-width=\"1.5\" stroke-dasharray=\"3 4\"/>`;\n// row0 outbreaks\nh+=`<text x=\"64\" y=\"${T0-6}\" font-size=\"22\" font-weight=\"700\" fill=\"#B5281F\">가금농장 발생</text><text x=\"64\" y=\"${T0+18}\" font-size=\"15\" fill=\"#5d6656\">11월 3일 첫 발생 이후 3건</text>`;\n[[\"2026-11-03\",\"연천\"],[\"2026-11-06\",\"장흥\"],[\"2026-11-07\",\"여주\"]].forEach(([t,l],i)=>{h+=`<circle cx=\"${x(t)}\" cy=\"${T0}\" r=\"11\" fill=\"#B5281F\"/>`;if(l)h+=`<text x=\"${x(t)+(i==2?18:-18)}\" y=\"${T0+7}\" text-anchor=\"${i==2?\"start\":\"end\"}\" font-size=\"19\" font-weight=\"900\" fill=\"#B5281F\">${l}</text>`;});\nh+=`<text x=\"1136\" y=\"${T0+7}\" text-anchor=\"end\" font-size=\"26\" font-weight=\"900\" fill=\"#B5281F\">3건</text>`;\nconst rows=[[\"전국 일제 소독 주간\",\"가금농장·축산시설·차량\",\"2026-11-04\",\"2026-11-17\",\"11.4~17\"],\n[\"백신접종반 출입 제한\",\"경기·충남 산란계 농장\",\"2026-11-07\",\"2026-11-14\",\"11.7~14\"],\n[\"알 환적장 긴급점검\",\"전국 산란계 농장\",\"2026-11-05\",\"2026-11-16\",\"11.5~16\"]];\nrows.forEach(([n,u,a,b,lab],i)=>{const cy=T0+(i+1)*rh+8;\n h+=`<text x=\"64\" y=\"${cy+3}\" font-size=\"22\" font-weight=\"700\" fill=\"#1F211C\">${n}</text><text x=\"64\" y=\"${cy+25}\" font-size=\"15\" fill=\"#5d6656\">${u}</text>`;\n h+=`<rect x=\"${x(a)}\" y=\"${cy-8}\" width=\"${x(b)-x(a)}\" height=\"16\" rx=\"8\" fill=\"#2F5E35\"/>`;\n h+=`<text x=\"1136\" y=\"${cy+7}\" text-anchor=\"end\" font-size=\"21\" font-weight=\"900\" fill=\"#2F5E35\">${lab}</text>`;});\nconst y2=T0+4*rh+40;\nh+=`<text x=\"64\" y=\"${y2}\" font-size=\"18\" fill=\"#3d4437\">전국 산란계 정밀검사</text><text x=\"270\" y=\"${y2+2}\" font-size=\"26\" font-weight=\"900\" fill=\"#1F211C\">분기 1회 → <tspan fill=\"#B5281F\">2주 1회</tspan></text>`;\nh+=`<text x=\"640\" y=\"${y2}\" font-size=\"18\" fill=\"#3d4437\">여주 방역대 가금농장</text><text x=\"830\" y=\"${y2+2}\" font-size=\"26\" font-weight=\"900\" fill=\"#B5281F\">38호 정밀검사</text>`;\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026110900003": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>식품·유통</p>\n<h1>세계 식량가격 1.2% 하락…<br>설탕은 6.6% 뛰었다</h1>\n<p class=\"dek\">FAO 세계식량가격지수 10월 품목군별 전월 대비 증감률(2014~2016년 평균=100).<br>올랐으면 빨강, 내렸으면 녹색.</p></div>\n<svg class=\"chart\" width=\"1200\" height=\"440\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 유엔 식량농업기구(FAO)·농림축산식품부(2026.11.7 발표)</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst rows=[[\"전체\",-1.2,133.9],[\"곡물\",-4.5,116.8],[\"유지류\",0.3,199.2],[\"육류\",-1.2,125.5],[\"유제품\",-1.1,117.8],[\"설탕\",6.6,121.3]];\nconst s=document.getElementById('c'),Z=600,k=50,rh=54,T0=80;let h='';\nh+=`<text x=\"${Z}\" y=\"${T0-24}\" text-anchor=\"middle\" font-size=\"15\" fill=\"#3d4437\" font-weight=\"700\">0%</text>`;\nh+=`<line x1=\"${Z}\" y1=\"${T0-14}\" x2=\"${Z}\" y2=\"${T0+rows.length*rh-26}\" stroke=\"#1F211C\" stroke-width=\"1.5\" stroke-dasharray=\"3 4\"/>`;\nh+=`<text x=\"1136\" y=\"${T0-24}\" text-anchor=\"end\" font-size=\"15\" fill=\"#3d4437\">10월 지수</text>`;\nrows.forEach(([n,v,idx],i)=>{const cy=T0+i*rh,up=v>0,col=up?'#B5281F':'#2F5E35',all=n==='전체';\n h+=`<text x=\"64\" y=\"${cy+8}\" font-size=\"24\" font-weight=\"${all?900:700}\" fill=\"#1F211C\">${n}</text>`;\n const x2=Z+v*k; h+=`<line x1=\"${Z}\" y1=\"${cy}\" x2=\"${x2}\" y2=\"${cy}\" stroke=\"${col}\" stroke-width=\"18\" stroke-linecap=\"butt\"/>`;\n const lab=(up?'+':'')+v.toFixed(1)+'%'; h+=`<text x=\"${up?x2+14:x2-14}\" y=\"${cy+9}\" text-anchor=\"${up?'start':'end'}\" font-size=\"25\" font-weight=\"900\" fill=\"${col}\">${lab}</text>`;\n h+=`<text x=\"1136\" y=\"${cy+8}\" text-anchor=\"end\" font-size=\"22\" font-weight=\"${all?900:700}\" fill=\"#1F211C\">${idx.toFixed(1)}</text>`;\n if(all)h+=`<line x1=\"64\" y1=\"${cy+28}\" x2=\"1136\" y2=\"${cy+28}\" stroke=\"#1F211C\" stroke-opacity=\".15\"/>`;\n});\nh+=`<text x=\"64\" y=\"${T0+rows.length*rh+10}\" font-size=\"17\" fill=\"#3d4437\">1년 전(2025년 10월)보다 전체 지수는 5.9% 높고, 유제품은 16.9% 낮다.</text>`;\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026111000001": {
  "style": "codex date(news-card-style 1절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"base.css\"><style>\nbody{background:var(--iv);color:var(--ink)}.brand{color:var(--g)}\nh1{position:absolute;left:60px;top:104px;font-size:72px;color:var(--g)}\n.date{position:absolute;left:60px;top:278px;background:var(--g);color:#F5F1E6;font-weight:900;font-size:24px;padding:10px 22px;border-radius:6px}\n.date i{color:var(--gold);font-style:normal;margin-right:12px}\n.rows{position:absolute;left:60px;right:60px;top:346px}\n.r{display:flex;align-items:baseline;gap:22px;padding:11px 0;border-bottom:1.5px solid #d8cfb6}\n.r b{font-family:\"BHS\";font-weight:400;font-size:54px;color:var(--gold);line-height:1;width:200px}\n.r span{font-size:23px;font-weight:700}.r small{font-size:18px;font-weight:400;color:#5a5446;margin-left:10px}\n.chk{position:absolute;left:60px;right:60px;bottom:66px;font-size:18px;color:#3b3a33}\n.chk b{color:var(--sal)}\n.foot{color:#7b735f}\n</style><body>\n<div class=\"brand\">NEWS THE HILL</div><div class=\"sec\">송파 · 일자리</div>\n<h1>이력서 들고 오면<br>현장 면접 '1·9데이'</h1>\n<div class=\"date\"><i>11월 13일(금)</i>오후 3~5시 · 송파구청 4층 대강당</div>\n<div class=\"rows\">\n<div class=\"r\"><b>5개 기업</b><span>판매·서비스·상품검수·조경 등</span></div>\n<div class=\"r\"><b>50명</b><span>채용 예정<small>지난 5월 행사 최종 취업 19명</small></span></div>\n<div class=\"r\"><b>12일까지</b><span>사전 신청<small>송파일자리센터 방문·전화·QR · 당일 현장 접수도 가능</small></span></div>\n</div>\n<div class=\"chk\"><b>문의</b>  송파일자리센터 02-2147-3680~4</div>\n<div class=\"foot\"><span>자료: 송파구 · 뉴스더힐</span><span>2026.11.10 발표</span></div>\n</body>\n"
 },
 "news-2026111000002": {
  "style": "codex dark(news-card-style 1절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"base.css\"><style>\nbody{background:var(--g);color:#F5F1E6}.brand{color:#F5F1E6}\nh1{position:absolute;left:60px;top:104px;font-size:70px;color:#F5F1E6}\n.big{position:absolute;left:60px;top:318px;display:flex;align-items:baseline;gap:18px}\n.big b{font-family:\"BHS\";font-size:118px;color:var(--sal);line-height:1}\n.big span{font-size:22px;font-weight:700}.big small{display:block;font-size:17px;font-weight:400;opacity:.75;margin-top:4px}\n.caf{position:absolute;right:60px;top:300px;width:470px;border-left:2px solid rgba(176,138,62,.6);padding-left:26px}\n.caf div{padding:9px 0;border-bottom:1px solid rgba(245,241,230,.15)}\n.caf b{color:var(--gold);font-size:21px;font-weight:900;display:block}.caf p{font-size:18px;opacity:.9;margin-top:2px}\n.band{position:absolute;left:60px;top:500px;width:560px;border:2px solid var(--sal);border-radius:8px;padding:12px 18px;font-size:19px;line-height:1.45}\n.band b{color:var(--sal)}\n.foot{color:rgba(245,241,230,.7)}\n</style><body>\n<div class=\"brand\">NEWS THE HILL</div><div class=\"sec\">식품 안전</div>\n<h1>굴·과메기·배달회<br>겨울 수산물 검사</h1>\n<div class=\"big\"><b>720건</b><span>수거·검사<small>11월 9일 ~ 2027년 2월 26일</small></span></div>\n<div class=\"band\"><b>부적합이면</b> 판매금지·회수 후<br>식품안전나라(foodsafetykorea.go.kr)에 공개</div>\n<div class=\"caf\">\n<div><b>생식용 굴</b><p>대장균 · 노로바이러스</p></div>\n<div><b>황태·마른멸치 등</b><p>중금속 등</p></div>\n<div><b>과메기 · 배달회</b><p>식중독균 · 동물용의약품 등</p></div>\n</div>\n<div class=\"foot\"><span>자료: 식품의약품안전처 · 뉴스더힐</span><span>2026.11.10 발표</span></div>\n</body>\n"
 },
 "news-2026111000003": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>식품·유통</p>\n<h1>곤충산업 591억 원,<br>사료용이 끌어올렸다</h1>\n<p class=\"dek\">곤충별 판매액(2025년)과 1년 전 대비 증감률. 빨강은 늘어난 곤충, 녹색은 줄어든 곤충.<br>업 신고 업체는 2,949곳→2,760곳으로 6.4% 줄었다.</p></div>\n<svg class=\"chart\" width=\"1200\" height=\"440\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 농림축산식품부 '2025년 곤충산업 실태조사'</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst rows=[[\"동애등에(사료용)\",167.65,65.3],[\"흰점박이꽃무지\",107.86,-22.0],[\"갈색거저리\",58.00,-15.0],[\"장수풍뎅이\",36.92,8.3],[\"귀뚜라미\",35.18,16.4],[\"사슴벌레\",19.21,-2.9]];\nconst lab=[\"168억\",\"108억\",\"58억\",\"37억\",\"35억\",\"19억\"];\nconst s=document.getElementById('c'),X0=300,X1=820,x=v=>X0+v/180*(X1-X0),rh=56,T0=80;let h='';\nrows.forEach(([n,v,p],i)=>{const cy=T0+i*rh, up=p>0, col=up?'#B5281F':'#2F5E35', first=i===0;\n h+=`<text x=\"64\" y=\"${cy+8}\" font-size=\"23\" font-weight=\"${first?900:700}\" fill=\"#1F211C\">${n}</text>`;\n h+=`<line x1=\"${X0}\" y1=\"${cy}\" x2=\"${X1}\" y2=\"${cy}\" stroke=\"#1F211C\" stroke-opacity=\".08\" stroke-width=\"18\" stroke-linecap=\"round\"/>`;\n h+=`<line x1=\"${X0}\" y1=\"${cy}\" x2=\"${x(v)}\" y2=\"${cy}\" stroke=\"${col}\" stroke-width=\"18\" stroke-linecap=\"round\"/>`;\n h+=`<text x=\"${x(v)+18}\" y=\"${cy+9}\" font-size=\"25\" font-weight=\"900\" fill=\"#1F211C\">${lab[i]}</text>`;\n h+=`<text x=\"1136\" y=\"${cy+9}\" text-anchor=\"end\" font-size=\"26\" font-weight=\"900\" fill=\"${col}\">${up?'▲':'▼'} ${Math.abs(p).toFixed(1)}%</text>`;\n});\nh+=`<text x=\"1136\" y=\"${T0-40}\" text-anchor=\"end\" font-size=\"16\" fill=\"#3d4437\">1년 전 대비</text>`;\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026111000004": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>식품·유통</p>\n<h1>맛도 건강도…<br>저당·단백질 소비 늘었다</h1>\n<p class=\"dek\">품목별 소비 증가율. 2027 식품외식산업전망(11월 4~5일, 코엑스)에서 소개된 식품 구매 행태.<br>단백질 음료는 과거 2년 대비 최근 1년간 소비 기준.</p></div>\n<svg class=\"chart\" width=\"1200\" height=\"440\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 농림축산식품부 보도자료(11월 8일)</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst rows=[[\"저당 아이스크림(빙과류)\",53.7],[\"단백질 음료\",50.3],[\"디카페인 음료\",22.4],[\"무·논알콜 주류\",20],[\"제로 음료\",18.3]];\nconst s=document.getElementById('c'),X0=360,X1=800,x=v=>X0+v/60*(X1-X0),rh=62,T0=86;let h='';\nrows.forEach(([n,v],i)=>{const cy=T0+i*rh;\n h+=`<text x=\"64\" y=\"${cy+8}\" font-size=\"23\" font-weight=\"700\" fill=\"#1F211C\">${n}</text>`;\n h+=`<line x1=\"${X0}\" y1=\"${cy}\" x2=\"${X1}\" y2=\"${cy}\" stroke=\"#1F211C\" stroke-opacity=\".08\" stroke-width=\"18\" stroke-linecap=\"round\"/>`;\n h+=`<line x1=\"${X0}\" y1=\"${cy}\" x2=\"${x(v)}\" y2=\"${cy}\" stroke=\"#B5281F\" stroke-width=\"18\" stroke-linecap=\"round\"/>`;\n h+=`<text x=\"${x(v)+18}\" y=\"${cy+9}\" font-size=\"26\" font-weight=\"900\" fill=\"#B5281F\">+${v}%</text>`;\n});\nh+=`<text x=\"1136\" y=\"${T0+40}\" text-anchor=\"end\" font-size=\"17\" fill=\"#3d4437\">기존 빙과 브랜드에</text><text x=\"1136\" y=\"${T0+64}\" text-anchor=\"end\" font-size=\"17\" fill=\"#3d4437\">저당·저칼로리를 접목한 제품</text><text x=\"1136\" y=\"${T0+112}\" text-anchor=\"end\" font-size=\"44\" font-weight=\"900\" fill=\"#B5281F\">+215.1%</text><text x=\"1136\" y=\"${T0+140}\" text-anchor=\"end\" font-size=\"16\" fill=\"#3d4437\">구매 금액 기준</text>`;\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026111000005": {
  "style": "codex(news-card-style 1절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"base.css\"><style>\nbody{background:var(--iv);color:var(--ink)}.brand{color:var(--g)}\nh1{position:absolute;left:60px;top:104px;font-size:72px;color:var(--g)}\n.rows{position:absolute;left:60px;right:60px;top:290px}\n.r{display:flex;align-items:baseline;gap:22px;padding:12px 0;border-bottom:1.5px solid #d8cfb6}\n.r b{font-family:\"BHS\";font-weight:400;font-size:52px;color:var(--gold);line-height:1;width:150px}\n.r span{font-size:24px;font-weight:700}.r small{font-size:18px;font-weight:400;color:#5a5446;margin-left:10px}\n.band{position:absolute;left:60px;right:60px;bottom:66px;background:var(--sal);color:#fff;font-weight:900;font-size:21px;text-align:center;padding:13px}\n.foot{color:#7b735f}\n</style><body>\n<div class=\"brand\">NEWS THE HILL</div><div class=\"sec\">생활·정보</div>\n<h1>녹인 고기,<br>다시 얼리지 마세요</h1>\n<div class=\"rows\">\n<div class=\"r\"><b>나눠서</b><span>얼리기 전 한 번 먹을 양씩<small>사 온 날 소분</small></span></div>\n<div class=\"r\"><b>쓸 만큼</b><span>필요한 양만 녹이기<small>냉장고 · 차가운 흐르는 물 · 전자레인지</small></span></div>\n<div class=\"r\"><b>바로</b><span>녹였으면 바로 조리<small>속까지 충분히 익히기</small></span></div>\n</div>\n<div class=\"band\">'해동 후 재냉동 금지' 원칙은 그대로 — 업체 소분용 일시 해동만 예외</div>\n<div class=\"foot\"><span>자료: 식품의약품안전처 · 구미시 보건소 · 뉴스더힐</span><span>2026.11.10</span></div>\n</body>\n"
 },
 "news-2026111000006": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>축산물 유통</p>\n<h1>온라인 축산물 판매업체<br>860여 곳 합동단속</h1>\n<p class=\"dek\">11월 11~25일 이력·등급·원산지 표시 점검, 허위표시 의심 땐 DNA 검사.<br>2027년 1월 8일부터 이력번호 거짓표시 처벌이 무거워진다.</p></div>\n<svg class=\"chart\" width=\"1200\" height=\"440\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 농림축산식품부(2026.11.10 발표)</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst s=document.getElementById('c');let h='';\nconst X0=360,X1=1000,sc=(X1-X0)/1000;\nh+=`<text x=\"64\" y=\"84\" font-size=\"21\" font-weight=\"700\" fill=\"#3d4437\">이력번호 거짓표시 벌금 상한</text>`;\nconst rows=[[\"현재\",\"500만 원 이하 벌금 또는 과태료\",500,\"#2F5E35\",\"500만 원\"],[\"2027.1.8부터\",\"1년 이하 징역 또는 1천만 원 이하 벌금\",1000,\"#B5281F\",\"1천만 원\"]];\nrows.forEach(([n,u,v,col,lab],i)=>{const cy=130+i*92;\n h+=`<text x=\"64\" y=\"${cy+2}\" font-size=\"25\" font-weight=\"900\" fill=\"${col}\">${n}</text><text x=\"64\" y=\"${cy+30}\" font-size=\"16\" fill=\"#5d6656\">${u}</text>`;\n h+=`<rect x=\"${X0}\" y=\"${cy-20}\" width=\"${v*sc}\" height=\"34\" rx=\"4\" fill=\"${col}\"/>`;\n h+=`<text x=\"${X0+v*sc+16}\" y=\"${cy+8}\" font-size=\"28\" font-weight=\"900\" fill=\"${col}\">${lab}</text>`;});\nh+=`<line x1=\"64\" y1=\"300\" x2=\"1136\" y2=\"300\" stroke=\"#1F211C\" stroke-opacity=\".15\"/>`;\nconst info=[[\"단속 기간\",\"11.11(수) ~ 11.25(수)\"],[\"대상\",\"온라인 쇼핑몰 등 약 860여 개소\"],[\"점검\",\"이력번호 표시·신고, 장부 기록\"]];\ninfo.forEach(([a,b],i)=>{const x=64+i*360;\n h+=`<text x=\"${x}\" y=\"345\" font-size=\"17\" fill=\"#5d6656\">${a}</text><text x=\"${x}\" y=\"380\" font-size=\"22\" font-weight=\"900\" fill=\"#1F211C\">${b}</text>`;});\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026111000007": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>식품산업</p>\n<h1>‘모두의 상생 프로젝트’<br>최대 3년·연 5억 원</h1>\n<p class=\"dek\">기업·농가·유통조직·연구기관이 시·도와 컨소시엄을 꾸려 신청.<br>2027년 지원 대상 공모가 11월 13일 시작된다.</p></div>\n<svg class=\"chart\" width=\"1200\" height=\"440\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 농림축산식품부(2026.11.10 발표, 일정은 최종 공고문에서 바뀔 수 있음)</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst s=document.getElementById('c');let h='';\nh+=`<text x=\"64\" y=\"78\" font-size=\"21\" font-weight=\"700\" fill=\"#3d4437\">프로젝트당 연간 최대 5억 원</text>`;\nconst X0=64,W=1072,parts=[[\"국비 2억 원 (40%)\",2,\"#2F5E35\"],[\"지방비 2억 원 (40%)\",2,\"#5c8a52\"],[\"자부담 1억 (20%)\",1,\"#9aa58a\"]];\nlet x=X0;parts.forEach(([l,v,c])=>{const w=W*v/5;h+=`<rect x=\"${x}\" y=\"98\" width=\"${w-4}\" height=\"54\" fill=\"${c}\"/><text x=\"${x+18}\" y=\"133\" font-size=\"21\" font-weight=\"900\" fill=\"#fff\">${l}</text>`;x+=w;});\nh+=`<text x=\"64\" y=\"205\" font-size=\"21\" font-weight=\"700\" fill=\"#3d4437\">신청 일정</text>`;\nconst ev=[[\"11.13(금)\",\"공모 시작\",0],[\"12.8(화) 18시\",\"주관사업자 → 대표 시·도 제출\",1],[\"12.15(화) 18시\",\"시·도 → aT 최종 접수\",1]];\nconst xs=[110,520,930];\nh+=`<line x1=\"110\" y1=\"262\" x2=\"930\" y2=\"262\" stroke=\"#2F5E35\" stroke-width=\"3\"/>`;\nev.forEach(([d,t,dl],i)=>{const c=dl?'#B5281F':'#2F5E35';\n h+=`<circle cx=\"${xs[i]}\" cy=\"262\" r=\"12\" fill=\"${c}\"/>`;\n h+=`<text x=\"${xs[i]}\" y=\"318\" text-anchor=\"middle\" font-size=\"27\" font-weight=\"900\" fill=\"${c}\">${d}</text>`;\n h+=`<text x=\"${xs[i]}\" y=\"352\" text-anchor=\"middle\" font-size=\"19\" fill=\"#1F211C\">${t}</text>`;});\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026111100003": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>장바구니 물가</p>\n<h1>단기비육 한우 '영하누'<br>최대 49.9% 할인 판매</h1>\n<p class=\"dek\">하반기 판매처·등급별 100g 가격과 각 업체 자사 판매가 대비 할인율.<br>사육기간을 28개월령 이하로 줄인 한우고기, 11월 12일부터 642개 매장.</p></div>\n<svg class=\"chart\" style=\"top:294px\" width=\"1200\" height=\"420\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 농림축산식품부(2026년 11월 11일 보도자료)</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst rows=[\n [\"하나로마트 수도권 6개점\",\"실속(1등급) · 11.12.부터 재고 소진 시까지\",9590,21.3,3920,20.3],\n [\"킴스클럽 28개점\",\"알뜰(2등급) · 11.18.~19.\",6990,30.0,3990,20.0],\n [\"GS더프레시 608개점\",\"엄선(1+등급) · 11.27.~28.\",8990,39.9,3490,41.4],\n [\"GS더프레시 608개점\",\"엄선(1++등급) · 11.27.~28.\",9990,49.9,3990,49.9]];\nconst s=document.getElementById('c'),X0=470,X1=960,x=v=>X0+v/55*(X1-X0),rh=88,T0=56;let h='';\nh+=`<rect x=\"${X0}\" y=\"6\" width=\"14\" height=\"14\" fill=\"#2F5E35\"/><text x=\"${X0+22}\" y=\"19\" font-size=\"16\" font-weight=\"700\" fill=\"#3d4437\">등심</text>`;\nh+=`<rect x=\"${X0+90}\" y=\"6\" width=\"14\" height=\"14\" fill=\"#2F5E35\" fill-opacity=\".45\"/><text x=\"${X0+112}\" y=\"19\" font-size=\"16\" font-weight=\"700\" fill=\"#3d4437\">국거리·불고기</text>`;\nconst f=n=>n.toLocaleString('ko-KR');\nrows.forEach(([a,b,p1,d1,p2,d2],i)=>{const cy=T0+i*rh;\n h+=`<text x=\"64\" y=\"${cy+6}\" font-size=\"23\" font-weight=\"900\" fill=\"#1F211C\">${a}</text>`;\n h+=`<text x=\"64\" y=\"${cy+36}\" font-size=\"17\" font-weight=\"500\" fill=\"#3d4437\">${b}</text>`;\n [[p1,d1,1,cy-2],[p2,d2,.45,cy+28]].forEach(([p,d,o,y])=>{\n  h+=`<line x1=\"${X0}\" y1=\"${y}\" x2=\"${X1}\" y2=\"${y}\" stroke=\"#1F211C\" stroke-opacity=\".07\" stroke-width=\"16\" stroke-linecap=\"round\"/>`;\n  h+=`<line x1=\"${X0}\" y1=\"${y}\" x2=\"${x(d)}\" y2=\"${y}\" stroke=\"#2F5E35\" stroke-opacity=\"${o}\" stroke-width=\"16\" stroke-linecap=\"round\"/>`;\n  h+=`<text x=\"${x(d)+16}\" y=\"${y+8}\" font-size=\"22\" font-weight=\"900\" fill=\"#2F5E35\">${d.toFixed(1)}%</text>`;\n  h+=`<text x=\"1136\" y=\"${y+8}\" text-anchor=\"end\" font-size=\"21\" font-weight=\"700\" fill=\"#1F211C\">${f(p)}원</text>`;\n });\n});\nh+=`<text x=\"1136\" y=\"19\" text-anchor=\"end\" font-size=\"16\" fill=\"#3d4437\">100g 가격</text>`;\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026111200002": {
  "style": "chart(news-card-style 0절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"chart-base.css\"><body>\n<div class=\"brand\">NEWS THE HILL</div>\n<div class=\"hd\"><p class=\"k\"><i></i>김장 물가</p>\n<h1>배추 넘쳐 값 뚝…<br>3만 톤 출하정지</h1>\n<p class=\"dek\">11월 상순 배추 한 포기 가격과 1년 전·평년 대비 변화율(왼쪽),<br>가을배추 생산량과 김장배추 수요 전망(오른쪽).</p></div>\n<svg class=\"chart\" style=\"top:290px\" width=\"1200\" height=\"420\" id=\"c\"></svg>\n<div class=\"foot\"><span>자료: 농림축산식품부(2026년 11월 11일 보도자료), 한국농촌경제연구원 전망</span><span>그래픽=뉴스더힐</span></div>\n<script>\nconst s=document.getElementById('c');let h='';\nconst X0=250,X1=560,x=v=>X0+v/50*(X1-X0);\nh+=`<rect x=\"${X0}\" y=\"6\" width=\"14\" height=\"14\" fill=\"#2F5E35\"/><text x=\"${X0+22}\" y=\"19\" font-size=\"16\" font-weight=\"700\" fill=\"#3d4437\">전년 대비</text>`;\nh+=`<rect x=\"${X0+120}\" y=\"6\" width=\"14\" height=\"14\" fill=\"#2F5E35\" fill-opacity=\".45\"/><text x=\"${X0+142}\" y=\"19\" font-size=\"16\" font-weight=\"700\" fill=\"#3d4437\">평년 대비</text>`;\nconst rows=[[\"도매가격\",\"포기당 1,900원\",42,32],[\"소비자가격\",\"포기당 3,211원\",14,20]];\nrows.forEach(([a,b,d1,d2],i)=>{const cy=72+i*120;\n h+=`<text x=\"64\" y=\"${cy+6}\" font-size=\"24\" font-weight=\"900\" fill=\"#1F211C\">${a}</text>`;\n h+=`<text x=\"64\" y=\"${cy+38}\" font-size=\"19\" font-weight=\"700\" fill=\"#3d4437\">${b}</text>`;\n [[d1,1,cy-2],[d2,.45,cy+34]].forEach(([d,o,y])=>{\n  h+=`<line x1=\"${X0}\" y1=\"${y}\" x2=\"${x(d)}\" y2=\"${y}\" stroke=\"#2F5E35\" stroke-opacity=\"${o}\" stroke-width=\"18\" stroke-linecap=\"round\"/>`;\n  h+=`<text x=\"${x(d)+16}\" y=\"${y+8}\" font-size=\"24\" font-weight=\"900\" fill=\"#2F5E35\">−${d}%</text>`;});\n});\nh+=`<line x1=\"660\" y1=\"0\" x2=\"660\" y2=\"296\" stroke=\"#1F211C\" stroke-opacity=\".15\"/>`;\nconst R=[[\"가을배추 생산량\",\"121만 4천 톤\",\"전년보다 19% 증가\",\"#B5281F\"],[\"김장배추 수요\",\"약 58만 3천 톤\",\"전년보다 9.1% 감소\",\"#2F5E35\"]];\nR.forEach(([a,b,c,col],i)=>{const y=40+i*130;\n h+=`<text x=\"710\" y=\"${y}\" font-size=\"19\" font-weight=\"700\" fill=\"#3d4437\">${a}</text>`;\n h+=`<text x=\"710\" y=\"${y+46}\" font-size=\"40\" font-weight=\"900\" fill=\"#1F211C\">${b}</text>`;\n h+=`<text x=\"710\" y=\"${y+80}\" font-size=\"20\" font-weight=\"900\" fill=\"${col}\">${c}</text>`;});\nh+=`<line x1=\"64\" y1=\"312\" x2=\"1136\" y2=\"312\" stroke=\"#1F211C\" stroke-opacity=\".15\"/>`;\nconst info=[[\"추가 대책\",\"해남 등 배추 약 3만 톤 출하정지\"],[\"수매비축\",\"가을배추 1만 톤(11월 중순부터)\"],[\"가격 약세 지속 시\",\"12월 하순 겨울배추 추가 비축\"]];\ninfo.forEach(([a,b],i)=>{const x=64+i*360;\n h+=`<text x=\"${x}\" y=\"346\" font-size=\"16\" fill=\"#5d6656\">${a}</text><text x=\"${x}\" y=\"376\" font-size=\"20\" font-weight=\"900\" fill=\"#1F211C\">${b}</text>`;});\ns.innerHTML=h;\n</script></body>\n"
 },
 "news-2026111200003": {
  "style": "codex rows(news-card-style 1절)",
  "html": "<!doctype html><meta charset=\"utf-8\"><link rel=\"stylesheet\" href=\"base.css\"><style>\nbody{background:var(--iv);color:var(--ink)}.brand{color:var(--g)}\nh1{position:absolute;left:60px;top:104px;font-size:68px;color:var(--g)}\n.rows{position:absolute;left:60px;right:60px;top:278px}\n.r{display:flex;align-items:baseline;gap:22px;padding:11px 0;border-bottom:1.5px solid #d8cfb6}\n.r b{font-family:\"BHS\";font-weight:400;font-size:40px;color:var(--gold);line-height:1;width:250px;flex:none}\n.r span{font-size:23px}\n.band{position:absolute;left:60px;right:60px;bottom:66px;background:var(--gold);color:#fff;font-weight:900;font-size:22px;text-align:center;padding:13px}\n.foot{color:#7b735f}\n</style><body>\n<div class=\"brand\">NEWS THE HILL</div><div class=\"sec\">농업 통상</div>\n<h1>CPTPP 등 통상현안<br>농업계 민관협의체</h1>\n<div class=\"rows\">\n<div class=\"r\"><b>전체회의</b><span>정부·연합체 소속 농업인단체·일부 품목단체·전문가</span></div>\n<div class=\"r\"><b>대표협의회</b><span>정부·주요단체장·전문가</span></div>\n<div class=\"r\"><b>실무협의회</b><span>정부(의제담당 국·과장급)·주요 단체 사무총장급·전문가</span></div>\n<div class=\"r\"><b>품목별 협의회</b><span>식량 / 원예·특작 / 축산·사료 / 식품·수출 / 소득·경영</span></div>\n</div>\n<div class=\"band\">협의체에 참여하기 어려운 농업인 위한 온라인 의견수렴 창구도 연다</div>\n<div class=\"foot\"><span>자료: 농림축산식품부 · 뉴스더힐</span><span>11.12 발표</span></div>\n</body>\n"
 }
}